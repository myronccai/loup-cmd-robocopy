@mode(host.dual)

# Application identity for robocopy: name, version, summary and the bits
# of its exit status. Keep APP_NAME and APP_VERSION in step with `name` and
# `version` in package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/robocopy by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "robocopy";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Copy and mirror directory trees (a Loup recreation of the Windows robocopy command).";

# robocopy's exit status is a bit mask (0 to 15), or 16 for a fatal error.
pub const EXIT_IN_SYNC: int = 0;      # nothing copied, nothing wrong
pub const BIT_COPIED: int = 1;        # one or more files were copied
pub const BIT_EXTRAS: int = 2;        # extra files or directories in the destination
pub const BIT_MISMATCH: int = 4;      # a file where a directory is, or the reverse
pub const BIT_FAILED: int = 8;        # some files or directories could not be copied
pub const EXIT_FATAL: int = 16;       # bad parameters or no source: nothing was done
