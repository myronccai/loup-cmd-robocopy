@mode(host.dual)

from appinfo import (EXIT_IN_SYNC, EXIT_FATAL);
from cli.args import (parse_args, MSG_NO_DEST);
from cli.usage import (usage, version_line);
from commands.robocopy import (run_robocopy);

# Parses argv, runs robocopy and returns the exit status (the bit mask, or
# 16 for a fatal error).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_FATAL;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_IN_SYNC;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_IN_SYNC;
    }
    if (opts.operands.len() == 0) {
        # Like robocopy without arguments: the usage, and a fatal status.
        println(usage());
        return EXIT_FATAL;
    }
    if (opts.operands.len() == 1) {
        printErr(MSG_NO_DEST);
        return EXIT_FATAL;
    }

    try {
        return run_robocopy(opts);
    } catch (Exception as e) {
        printErr(e.message);
        return EXIT_FATAL;
    }
}
